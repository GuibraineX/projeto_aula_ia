# Copie este arquivo para ".env" e preencha com as suas chaves.
# O .env NUNCA vai para o Git: ele está no .gitignore.

# Ollama Cloud (o modelo do chat roda na nuvem, nada para baixar)
# Crie a chave em https://ollama.com/settings/keys
OLLAMA_API_KEY=
MODELO=gpt-oss:20b

# Gemini (embeddings da busca nos manuais, como na Aula 5)
# Crie a chave em https://aistudio.google.com/apikey
# Opcional: sem ela, a busca usa comparação de palavras.
GEMINI_API_KEY=